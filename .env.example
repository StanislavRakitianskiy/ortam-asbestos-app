# Copy this file to .env.local and fill in the values. .env.local is gitignored; never commit secrets.

# Server-side only. Leave empty until you have a key; the home page then shows "Not configured".
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Gotenberg from docker-compose.yml (host port 3001 -> container port 3000).
GOTENBERG_URL=http://localhost:3001

# SQLite file. Prisma resolves the relative path from prisma/schema.prisma, so this is prisma/dev.db.
DATABASE_URL="file:./dev.db"

# Uploaded lab PDFs, generated reports and plans (gitignored).
STORAGE_DIR=./storage
