{
  "name": "ortam-asbestos-app",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "fixture:edge": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/make-edge-fixture.ts",
    "template:build": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/build-template.ts",
    "verify": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/ts-hooks.mjs scripts/verify-golden.ts",
    "setup": "npm ci && prisma generate && prisma migrate deploy"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.135.0",
    "@prisma/client": "6.19.3",
    "@tanstack/react-query": "5.104.4",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.0",
    "docxtemplater": "3.71.1",
    "lucide-react": "1.59.0",
    "next": "16.4.2",
    "next-themes": "0.4.6",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.3.289",
    "pizzip": "3.3.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-pdf": "11.0.0",
    "shadcn": "4.22.0",
    "sonner": "2.0.8",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "4.1.12",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "prisma": "6.19.3",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
